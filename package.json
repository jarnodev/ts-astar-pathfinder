{
  "name": "ts-astar-pathfinder",
  "version": "1.0.0",
  "description": "A simple A* pathfinding algorithm implementation in TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.dev.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "tsx",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "pathfinding",
    "A*",
    "algorithm",
    "typescript"
  ],
  "author": "Jarno Mensink",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarnodev/ts-astar-pathfinder"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "bugs": {
    "url": "https://github.com/jarnodev/ts-astar-pathfinder/issues"
  },
  "homepage": "https://github.com/jarnodev/ts-astar-pathfinder#readme"
}
